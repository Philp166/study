# Шаблон. Скопируй этот файл в .env и вставь свой настоящий ключ.
# Файл .env в git НЕ попадёт (он в .gitignore).
ANTHROPIC_API_KEY=sk-ant-...

# SaluteSpeech (Sber) — STT/TTS для голосового чата
# Получить: https://developers.sber.ru/studio/
SALUTE_SPEECH_AUTH=<Base64 от client_id:client_secret>
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
