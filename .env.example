# Шаблон. Скопируй этот файл в .env и вставь свой настоящий ключ.
# Файл .env в git НЕ попадёт (он в .gitignore).
ANTHROPIC_API_KEY=sk-ant-...

# Пароль на ВЕСЬ сайт (HTTP Basic Auth). Если не задан — пароль не спрашивается
# (удобно локально). На проде задай в дашборде Render. Только переменная окружения!
SITE_PASSWORD=your_secret_password_here

# PostgreSQL (Render). Если не задан — используется SQLite (cos.db).
# DATABASE_URL=postgresql://user:pass@host:5432/cos

# SaluteSpeech (Sber) — STT/TTS для голосового чата
# Получить: https://developers.sber.ru/studio/
SALUTE_SPEECH_AUTH=<Base64 от client_id:client_secret>
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
